<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.*" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.*" />
    <PackageReference Include="Hangfire.InMemory" Version="1.0.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Hangfire.Core pulls in Newtonsoft.Json 11.0.1, which has a known
         vulnerability. This direct reference floats it up to a patched one. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Microsoft.Data.SqlClient pulls in System.Security.Cryptography.Pkcs
         9.0.11, which has two known vulnerabilities (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7). This direct reference floats it up to the
         patched .NET 10 release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
